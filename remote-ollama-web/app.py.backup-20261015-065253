def parse_env_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].strip()
        if "=" in line:
            key, value = line.split("=", 1)
            values[key.strip()] = value.strip().strip("\"'")
    return values

ENV = parse_env_file(ENVFILE)
OLLAMA_URL = (os.getenv("OLLAMA_REMOTE_URL") or ENV.get("OLLAMA_REMOTE_URL") or ENV.get("OLLAMA_URL") or "").rstrip("/")
API_KEY = os.getenv("OLLAMA_REMOTE_API_KEY") or ENV.get("OLLAMA_REMOTE_API_KEY") or ""
API_ROOT = OLLAMA_URL if OLLAMA_URL.endswith("/api") else (OLLAMA_URL + "/api" if OLLAMA_URL else "")
WEB_PASSWORD = os.getenv("WEB_AGENT_PASSWORD", "")
SESSION_SECRET = os.getenv("WEB_AGENT_SESSION_SECRET", "")
COOKIE_SECURE = os.getenv("WEB_AGENT_COOKIE_SECURE", "1") == "1"
app = FastAPI(title="Remote Ollama MCP Web Agent", docs_url=None, redoc_url=None)
if SESSION_SECRET:
    app.add_middleware(SessionMiddleware, secret_key=SESSION_SECRET, session_cookie="agent_session", same_site="strict", https_only=COOKIE_SECURE, max_age=43200)
app.mount("/static", StaticFiles(directory=STATIC), name="static")
PENDING: dict[str, dict[str, Any]] = {}

class LoginBody(BaseModel):
    password: str
class ChatBody(BaseModel):
    message: str = Field(min_length=1, max_length=20000)
    model: str = Field(default="qwen3:8b", max_length=200)
    conversation_id: str | None = None
class ToolBody(BaseModel):
    name: str
    arguments: dict[str, Any] = {}
class CommandBody(BaseModel):
    command: str
class ApprovalBody(BaseModel):
    approved: bool

def require_config() -> None:
    if len(WEB_PASSWORD) < 14:
        raise HTTPException(503, "Set WEB_AGENT_PASSWORD to a unique password of at least 14 characters before starting.")
    if len(SESSION_SECRET) < 32:
        raise HTTPException(503, "Set WEB_AGENT_SESSION_SECRET to a random secret of at least 32 characters before starting.")
    if not OLLAMA_URL or not API_KEY:
        raise HTTPException(503, f"Missing OLLAMA_REMOTE_URL or OLLAMA_REMOTE_API_KEY in {ENVFILE}.")

def require_auth(req: Request) -> None:
    require_config()
    if req.session.get("authenticated") is not True:
        raise HTTPException(401, "Sign in required.")

def require_csrf(req: Request) -> None:
    token = req.session.get("csrf", "")
    supplied = req.headers.get("x-csrf-token", "")
    if not token or not hmac.compare_digest(token, supplied):
        raise HTTPException(403, "CSRF validation failed. Refresh and try again.")

def workspace_path(raw: str) -> Path:
    candidate = (WORKSPACE / raw).resolve()
    try:
        candidate.relative_to(WORKSPACE)
    except ValueError:
        raise HTTPException(400, "Path is outside the configured workspace.")
    return candidate

def relative_path(p: Path) -> str:
    try:
        r = str(p.relative_to(WORKSPACE))
        return r or "."
    except ValueError:
        return "."

def likely_mutating(name: str) -> bool:
    return any(word in name.lower() for word in ("write", "edit", "apply", "create", "delete", "remove", "command", "terminal", "test", "exec", "run", "move", "rename"))

def ollama_headers() -> dict[str, str]:
    # Credentials are used only by this backend; they are never returned to the browser.
    return {"Authorization": f"Bearer {API_KEY}", "X-API-Key": API_KEY, "Content-Type": "application/json"}

async def ollama_api(path: str, payload: dict[str, Any] | None = None, method: str = "POST") -> dict[str, Any]:
    require_config()
    async with httpx.AsyncClient(timeout=httpx.Timeout(120, connect=15)) as client:
        if method == "GET":
            response = await client.get(f"{API_ROOT}/{path}", headers=ollama_headers())
        else:
            response = await client.post(f"{API_ROOT}/{path}", headers=ollama_headers(), json=payload or {})
        try:
            response.raise_for_status()
        except httpx.HTTPStatusError as exc:
            raise HTTPException(502, f"Remote Ollama returned HTTP {exc.response.status_code}.")
        try:
            return response.json()
        except ValueError:
            raise HTTPException(502, "Remote Ollama returned invalid JSON.")

async def mcp(action: str, name: str | None = None, arguments: dict[str, Any] | None = None):
    try:
        from mcp import ClientSession, StdioServerParameters
        from mcp.client.stdio import stdio_client
    except Exception as exc:
        raise HTTPException(503, f"MCP SDK unavailable in the configured virtual environment: {exc}")
    server = AGENT_DIR / "server.py"
    python = Path.home() / ".venv/bin/python"
    if not server.is_file():
        raise HTTPException(503, f"Existing MCP server not found: {server}")
    if not python.exists():
        raise HTTPException(503, f"Expected Python virtual environment at {python}")
    params = StdioServerParameters(command=str(python), args=[str(server)], env={**os.environ, "CODING_WORKSPACE": str(WORKSPACE)})
    try:
        async with stdio_client(params) as (read_stream, write_stream):
            async with ClientSession(read_stream, write_stream) as session:
                await session.initialize()
                if action == "list":
                    result = await session.list_tools()
                    return [{"name": t.name, "description": t.description or "", "inputSchema": t.inputSchema} for t in result.tools]
                result = await session.call_tool(name or "", arguments or {})
                return {"isError": bool(getattr(result, "isError", False)), "content": [{"type": getattr(c, "type", "text"), "text": getattr(c, "text", str(c))} for c in getattr(result, "content", [])]}
    except HTTPException:
        raise
    except Exception as exc:
        raise HTTPException(502, f"MCP request failed: {type(exc).__name__}: {exc}")

def ollama_tool_schema(tools: list[dict[str, Any]]) -> list[dict[str, Any]]:
    converted = []
    for tool in tools:
        converted.append({"type": "function", "function": {"name": tool["name"], "description": tool["description"], "parameters": tool.get("inputSchema") or {"type": "object", "properties": {}}}})
    return converted

@app.middleware("http")
async def security_headers(request: Request, call_next):
    response = await call_next(request)
    response.headers.update({"X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY", "Referrer-Policy": "no-referrer", "Permissions-Policy": "camera=(), microphone=(), geolocation=()", "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"})
    return response

