@app.get("/api/session")
async def get_session(req: Request):
    require_config()
    if req.session.get("authenticated") is not True:
        return {"authenticated": False}
    if not req.session.get("csrf"):
        req.session["csrf"] = secrets.token_urlsafe(32)
    return {"authenticated": True, "csrf": req.session["csrf"], "workspace": str(WORKSPACE)}

@app.post("/api/login")
async def login(body: LoginBody, req: Request):
    require_config()
    if not hmac.compare_digest(body.password, WEB_PASSWORD):
        await asyncio.sleep(0.4)
        raise HTTPException(401, "Invalid password.")
    req.session.clear()
    req.session["authenticated"] = True
    req.session["csrf"] = secrets.token_urlsafe(32)
    return {"ok": True, "csrf": req.session["csrf"]}

@app.post("/api/logout")
async def logout(req: Request):
    require_auth(req); require_csrf(req)
    req.session.clear()
    return {"ok": True}

